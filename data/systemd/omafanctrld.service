[Unit]
Description=omafanctrl fan control daemon
Documentation=https://github.com/omafanctrl/omafanctrl
After=dbus.service
Requires=dbus.service
# The EC interface must exist before the daemon starts.
After=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/bin/omafanctrld --config /etc/omafanctrl/TPFanControl.ini
# Safety net: if the daemon is killed (including `kill -9`, where the in-process
# watchdog cannot run), hand the fan back to the firmware.
ExecStopPost=/usr/bin/omafanctrld --revert
Restart=on-failure
RestartSec=2

# The daemon needs raw EC access through ec_sys.
User=root
Group=root

# Give the watchdog time to revert on a clean SIGTERM before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=5

# Hardening: the daemon only needs the EC window and the D-Bus system bus.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/omafanctrl

[Install]
WantedBy=multi-user.target