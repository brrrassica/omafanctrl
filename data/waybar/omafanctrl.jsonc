// omafanctrl Waybar module for Omarchy Quattro (4.x).
//
// Merge the `custom/omafanctrl` block into the `modules-right` (or
// `modules-left`/`modules-center`) array of your Waybar config, and add the
// module definition. The module polls the daemon every 2 seconds and renders
// the mode, RPM, and maximum temperature.
//
// The `class` is the current mode (`bios`, `manual`, `smart`) or `error`, so
// the CSS in data/waybar/omafanctrl.css can colour it per mode.

{
  "modules-right": ["custom/omafanctrl"],

  "custom/omafanctrl": {
    // `--show` accepts any of: icon, mode, rpm, temp.
    // Set `--icon` to a Nerd Font glyph, e.g. "\uf863" (fan).
    "exec": "omafanctrl-waybar --show icon,mode,rpm,temp --icon \"\"",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "tooltip": true,
    "on-click": "omafanctrl mode cycle --notify",
    "on-click-right": "omafanctrl toggle --notify",
    "on-scroll-up": "omafanctrl level up --notify",
    "on-scroll-down": "omafanctrl level down --notify"
  }
}